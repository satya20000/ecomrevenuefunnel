{
  "name": "ProfessionalAnalytics",
  "dataColors": [
    "#0A827C",
    "#17324D",
    "#B88641",
    "#A34E56",
    "#8092A5",
    "#6B8E93"
  ],
  "background": "#F3F6F9",
  "foreground": "#17324D",
  "tableAccent": "#0A827C",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#17324D"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4EAF0"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    }
  }
}
